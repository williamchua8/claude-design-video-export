{
  "name": "claude-design-video",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Render Claude Design animation bundles to high-quality MP4 — deterministic frames, correct blur/glow compositing, concurrent encoding.",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "cdv": "./render.js"
  },
  "scripts": {
    "start": "node render.js",
    "doctor": "node render.js --action doctor",
    "setup": "playwright install chromium",
    "selftest": "node test/selftest.js",
    "sweeptest": "node test/sweep-test.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "playwright": "1.56.1"
  }
}
